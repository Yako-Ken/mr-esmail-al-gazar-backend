# Database (SQLite file; use a durable volume in production)
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=5000
NODE_ENV=development

# CORS - comma-separated allowlist of web origins, e.g. "https://app.example.com".
# Use "*" for development only. Native mobile apps send no Origin header and are always allowed.
ALLOWED_ORIGINS="*"

# Production URL (used by Flutter in release mode)
PRODUCTION_URL="https://your-backend.example.com"

# JWT Secret (required, min 16 chars, no placeholder values)
JWT_SECRET="change-me-to-a-long-random-string"

# Super Admin master account (created by seed; password must be a bcrypt hash)
SUPER_ADMIN_PHONE="01000000000"
SUPER_ADMIN_PASSWORD_HASH="$2b$10$..."

# Email (nodemailer) for OTP delivery - optional in dev
EMAIL_USER=""
EMAIL_PASS=""

# Bunny.net Storage & CDN (optional - falls back to local uploads/)
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_CDN_URL="https://your-zone.b-cdn.net"
# Advanced Token Authentication key from the Bunny Pull Zone (server-side only)
BUNNY_CDN_TOKEN_KEY=""
BUNNY_STORAGE_REGION=""

# Bunny Stream API (for video upload tickets / streaming)
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
# Stream delivery hostname, e.g. https://vz-123456.b-cdn.net (no trailing slash)
BUNNY_STREAM_CDN_URL=""
# Token Authentication key from the Stream CDN security settings
BUNNY_STREAM_TOKEN_KEY=""

# Paymob Egypt (server-side secrets; leave blank to disable paid checkout safely)
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_API_BASE_URL="https://accept.paymob.com"

# Feature flags
# WHATSAPP_OTP_ENABLED: set to "true" ONLY after a real SMS/WhatsApp OTP provider
# is integrated. Leaving it unset keeps the OTP placeholder endpoints disabled (501).
WHATSAPP_OTP_ENABLED="false"

# Crash reporting (Flutter side — passed at build time via --dart-define=SENTRY_DSN=...)
# Create a free project at sentry.io → Settings → Projects → DSN. Empty = disabled.
SENTRY_DSN=""
