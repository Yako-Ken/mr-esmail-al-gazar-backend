# استخدام نسخة خفيفة من Node.js
FROM node:18-alpine

# تحديد مجلد العمل جوه السيرفر
WORKDIR /app

# نسخ ملفات الحزم الأول عشان تسريع البناء
COPY package*.json ./

# تسطيب المكتبات
RUN npm install

# نسخ باقي ملفات المشروع
COPY . .

# فتح البورت اللي إنت محدده في المتغيرات
EXPOSE 5000

# أمر تشغيل السيرفر
CMD ["npm", "start"]