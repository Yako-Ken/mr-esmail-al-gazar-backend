generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?  @unique
  password    String
  role        String   @default("STUDENT")
  status      String   @default("pending")
  isApproved  Boolean  @default(false)
  isVerified  Boolean  @default(false)
  sessionVersion Int   @default(0) // Increment to revoke every previously issued JWT
  permissions String   @default("[]")
  subjectId   String?
  parentPhone String?   // Unverified contact hint only; never grants parent access
  deviceId    String?   // For device-limit enforcement (max 2 accounts per device)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vodafoneCashNumber String?
  instapayHandle     String?

  parentTeacherId String?
  parentTeacher   User?   @relation("TeacherAssistants", fields: [parentTeacherId], references: [id])
  assistants      User[]  @relation("TeacherAssistants")

  courses         Course[]                @relation("TeacherCourses")
  lessons         Lesson[]
  studentRelations StudentParentRelation[] @relation("Student")
  parentRelations  StudentParentRelation[] @relation("Parent")
  trackings       Tracking[]
  courseEnrollments CourseEnrollment[]    @relation("StudentCourseEnrollments")
  attendanceRecords AttendanceRecord[]    @relation("AttendanceStudent")
  lessonProgresses  LessonProgress[]      @relation("StudentProgress")
  notifications    Notification[]
  pushTokens       PushToken[]
  sessions         UserSession[]
  dataPrivacyRequests DataPrivacyRequest[]
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String
  userAgent  String?
  ipHint     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt, expiresAt])
}

model DataPrivacyRequest {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  status       String
  requestKey   String?   @unique
  reason       String?
  requestedAt  DateTime  @default(now())
  scheduledFor DateTime?
  completedAt  DateTime?
  canceledAt   DateTime?
  attempts     Int       @default(0)
  lastError    String?
  processingStartedAt DateTime?
  previousUserStatus  String?

  @@index([userId, type, requestedAt])
  @@index([status, scheduledFor])
}

model StudentParentRelation {
  id        String   @id @default(uuid())
  studentId String
  parentId  String
  student   User     @relation("Student", fields: [studentId], references: [id])
  parent    User     @relation("Parent", fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

model ParentLinkRequest {
  id           String    @id @default(uuid())
  studentId    String
  studentPhone String
  codeHash     String
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  parentId     String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId, status, createdAt])
  @@index([studentPhone, status])
}

model Course {
  id           String   @id @default(uuid())
  teacherId    String
  teacher      User     @relation("TeacherCourses", fields: [teacherId], references: [id])
  title        String
  description  String?
  subject      String?
  grade       String?
  price        Float    @default(0) // Legacy display field; migrate callers to priceMinor
  priceMinor   Int      @default(0)
  currency     String   @default("EGP")
  thumbnailUrl String?
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lessons      Lesson[]                @relation("CourseLessons")
  courseEnrollments CourseEnrollment[] @relation("StudentCourseEnrollments")
  lessonProgresses  LessonProgress[]   @relation("CourseProgress")

  @@index([isPublished, createdAt])
}

model CourseEnrollment {
  id             String   @id @default(uuid())
  studentId      String
  courseId       String
  paymentMethod  String
  receiptImageUrl String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student  User   @relation("StudentCourseEnrollments", fields: [studentId], references: [id])
  course   Course @relation("StudentCourseEnrollments", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Lesson {
  id            String   @id @default(uuid())
  // K-12 standard constants (stored as plain strings — no FK)
  subject       String?
  grade         String?
  courseId      String?
  course        Course?  @relation("CourseLessons", fields: [courseId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User     @relation(fields: [teacherId], references: [id])
  title         String
  videoUrl      String?
  bunnyVideoId  String?  // The GUID for Bunny Stream
  videoLibraryId String? // The Library ID for Bunny Stream
  thumbnailUrl  String?
  pdfUrl        String?
  description   String?
  homeworkText  String?
  homeworkPdfUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  quizzes       Quiz[]                @relation("LessonQuizzes")
  trackings     Tracking[]            @relation("LessonTrackings")
  progresses    LessonProgress[]      @relation("LessonProgress")
}

model Quiz {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation("LessonQuizzes", fields: [lessonId], references: [id], onDelete: Cascade)
  questions String
}

model Tracking {
  id          String    @id @default(uuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  lessonId    String
  lesson      Lesson    @relation("LessonTrackings", fields: [lessonId], references: [id], onDelete: Cascade)
  isPresent   Boolean   @default(false)
  hwStatus    String    @default("NOT_SUBMITTED")
  essayStatus String    @default("NOT_SUBMITTED")
  hwFileUrl   String?
  quizScore   Int?
  essayAnswers String?  // JSON string storing student's essay answers
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, lessonId])
}

model AttendanceSession {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  subject   String
  grade     String
  ownerId   String
  createdAt DateTime @default(now())
  records   AttendanceRecord[]
}

model AttendanceQrUse {
  id        String   @id @default(uuid())
  jti       String   @unique
  studentId String
  sessionId String
  expiresAt DateTime
  usedAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([studentId, sessionId])
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation("AttendanceStudent", fields: [studentId], references: [id])
  timestamp DateTime          @default(now())

  @@unique([sessionId, studentId])
}

model LessonProgress {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation("StudentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson   @relation("LessonProgress", fields: [lessonId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?  @relation("CourseProgress", fields: [courseId], references: [id], onDelete: Cascade)
  watchPercentage Float    @default(0)
  isCompleted     Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([studentId, lessonId])
}

model PasswordResetOTP {
  id           String    @id @default(uuid())
  studentPhone String
  otp          String    // HMAC digest; plaintext OTP is never persisted
  resetToken   String?   @unique // SHA-256 digest; plaintext token is never persisted
  attempts     Int       @default(0)
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([studentPhone])
}

// Analytics event tracking (self-hosted, GDPR-safe)
model PaymentOrder {
  id                  String   @id @default(uuid())
  studentId           String
  courseId            String
  amountMinor         Int
  currency            String   @default("EGP")
  provider            String
  status              String   @default("PENDING")
  idempotencyKey      String   @unique
  providerOrderId     String?  @unique
  providerIntentionId String?  @unique
  checkoutUrl         String?
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([studentId, createdAt])
  @@index([courseId, status])
}

model PaymentAttempt {
  id                String   @id @default(uuid())
  paymentOrderId    String
  providerAttemptId String?  @unique
  status            String   @default("CREATED")
  responseCode      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentOrderId, createdAt])
}

model PaymentEvent {
  id                 String   @id @default(uuid())
  externalEventId    String   @unique
  paymentOrderId     String?
  eventType           String
  payload             String
  processingStatus    String   @default("RECEIVED")
  createdAt           DateTime @default(now())
  processedAt         DateTime?

  @@index([paymentOrderId, createdAt])
}

model CourseEntitlement {
  id            String    @id @default(uuid())
  studentId     String
  courseId      String
  sourceOrderId String?
  status        String    @default("ACTIVE")
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([studentId, courseId])
  @@index([sourceOrderId])
}

model Refund {
  id                 String   @id @default(uuid())
  paymentOrderId     String
  providerRefundId   String?  @unique
  amountMinor        Int
  currency           String   @default("EGP")
  status             String   @default("REQUESTED")
  reason             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([paymentOrderId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  metadata  String? // JSON string
  timestamp DateTime @default(now())

  @@index([eventType, timestamp])
  @@index([userId, timestamp])
}

// Persistent notifications store
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // 'lesson_new' | 'payment_approved' | 'grade_posted' | 'announcement'
  title     String
  body      String
  data      String?  // JSON payload (e.g. {courseId, lessonId}) for deep link navigation
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt, isRead])
}

// Store each user's Firebase/Expo push token
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // 'android' | 'ios'
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, active])
  @@unique([userId, token])
}
